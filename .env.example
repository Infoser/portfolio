# Client-exposed (safe to bundle — gated by Supabase RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL used to build absolute og:image / twitter:image URLs in
# index.html during build. Optional — leave blank for root-relative URLs
# (crawlers resolve against the page origin). Set in Vercel Project Settings
# to e.g. https://ishan-portfolio.vercel.app for strict absolute URLs.
VITE_SITE_URL=

# Server-only (Vercel env vars — NEVER prefix with VITE_)
# ADMIN_SLUG is read only by /api/admin-gate.ts and never shipped to the browser.
ADMIN_SLUG=

# Contact form (server-only — read by /api/contact.ts)
# GMAIL_USER is the sender Gmail address. Must have 2FA enabled and an
# App Password generated at https://myaccount.google.com/apppasswords
# (NEVER use the account's primary password).
GMAIL_USER=issuatstudy090@gmail.com
# The 16-char App Password (no spaces). Never commit this.
GMAIL_APP_PASSWORD=
# Destination address where contact messages get delivered. Defaults to
# GMAIL_USER if unset, so you only need this if you want messages routed
# to a DIFFERENT inbox than the sender.
CONTACT_RECIPIENT=issuatstudy090@gmail.com
